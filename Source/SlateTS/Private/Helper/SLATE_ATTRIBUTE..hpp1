	MAKE_ATTRIBUTE_SETTER(FVector2D, ContentScale);
	MAKE_ATTRIBUTE_SETTER(FSlateColor, ButtonColorAndOpacity);
	MAKE_ATTRIBUTE_SETTER(FSlateColor, ForegroundColor);
	MAKE_ATTRIBUTE_SETTER(FSlateColor, BorderBackgroundColor);
	MAKE_ATTRIBUTE_SETTER(ECheckBoxState, IsChecked);
	MAKE_ATTRIBUTE_SETTER(bool, ShowEffectWhenDisabled);
	MAKE_ATTRIBUTE_SETTER(EMenuPlacement, MenuPlacement);
	MAKE_ATTRIBUTE_SETTER(const FSlateBrush*, BorderImage);
	MAKE_ATTRIBUTE_SETTER(FMargin, ContentPadding);
