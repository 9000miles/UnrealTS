#pragma once
#include "JsObject.h"
#include "v8.h"
#include "V8Utils.h"
#include "Converter.hpp"

#define $SLATE_ATTRIBUTE(Type, VarName)\
$Arguments__SLATE_ATTRIBUTE::Set_Variable<Type, $Arguments__SLATE_ATTRIBUTE::$$__##Type##_##VarName##__$$>(Arguments, Isolate, JsObject, #VarName)

//#define //$SLATE_ATTRIBUTE_WITH_TYPE(Name, Type);\
//$Arguments__SLATE_ATTRIBUTE::Set_##Name##Type(Arguments, Isolate, JsObject, #Name, "")

/** ======================= SET_SLATE_ATTRIBUTE ======================= **/
namespace $Arguments__SLATE_ATTRIBUTE
{
	template <typename TType, typename Tag, typename TArgumentType>
	void Set_Variable(TArgumentType& Arguments, v8::Isolate* Isolate, v8::Local<v8::Object>& JsObject, const char* VariableName) {
		v8::Local<v8::Context> Context = Isolate->GetCurrentContext();
		const bool bHas = JsObject->Has(Context, puerts::FV8Utils::ToV8String(Isolate, VariableName)).FromMaybe(false);
		if (!bHas) return;
		v8::Local<v8::Value> JsValue = JsObject->Get(Context, puerts::FV8Utils::ToV8String(Isolate, VariableName)).ToLocalChecked();

		$AttributeSetter<TType, Tag, TArgumentType>::SetAttribute(Arguments, Context, JsValue);
	}

	template <typename TType, typename TId, typename TArgumentType>
	struct $AttributeSetter;

#define MAKE_ATTRIBUTE_SETTER(Type, VarName)\
	struct $$__##Type##_##VarName##__$$ {};\
	template <typename TArgumentType>\
	struct $AttributeSetter<Type, $$__##Type##_##VarName##__$$, TArgumentType> {\
		static void SetAttribute(TArgumentType& Arguments, v8::Local<v8::Context> Context, v8::Local<v8::Value> JsValue) {\
			Arguments._##VarName = WidgetAttribute::MakeAttribute<Type>(Context, JsValue);\
		}\
	};

	MAKE_ATTRIBUTE_SETTER(FText, Text);
	MAKE_ATTRIBUTE_SETTER(FSlateFontInfo, Font);
	MAKE_ATTRIBUTE_SETTER(const FSlateBrush*, StrikeBrush);
	MAKE_ATTRIBUTE_SETTER(FSlateColor, ColorAndOpacity);
	MAKE_ATTRIBUTE_SETTER(FLinearColor, ColorAndOpacity);
	MAKE_ATTRIBUTE_SETTER(FVector2D, ShadowOffset);
	MAKE_ATTRIBUTE_SETTER(FLinearColor, ShadowColorAndOpacity);
	MAKE_ATTRIBUTE_SETTER(FLinearColor, HighlightColor);
	MAKE_ATTRIBUTE_SETTER(const FSlateBrush*, HighlightShape);
	MAKE_ATTRIBUTE_SETTER(FText, HighlightText);
	MAKE_ATTRIBUTE_SETTER(float, WrapTextAt);
	MAKE_ATTRIBUTE_SETTER(bool, AutoWrapText);
	MAKE_ATTRIBUTE_SETTER(ETextWrappingPolicy, WrappingPolicy);
	MAKE_ATTRIBUTE_SETTER(ETextTransformPolicy, TransformPolicy);
	MAKE_ATTRIBUTE_SETTER(FMargin, Margin);
	MAKE_ATTRIBUTE_SETTER(FMargin, Padding);
	MAKE_ATTRIBUTE_SETTER(float, LineHeightPercentage);
	MAKE_ATTRIBUTE_SETTER(ETextJustify::Type, Justification);
	MAKE_ATTRIBUTE_SETTER(float, MinDesiredWidth);
