/** ======================= SET_SLATE_ATTRIBUTE ======================= **/
namespace $Arguments__SLATE_ATTRIBUTE
{
	// 辅助模板，用于决定 Arguments 的哪个成员应该被设置
	template <typename TType, typename TId, typename TArgumentType>
	void AttributeSetter(TArgumentType& Arguments, v8::Local<v8::Context> Context, v8::Local<v8::Value> JsValue);

#define MAKE_ATTRIBUTE_SETTER(Type, VarName)\
	struct $$__##Type##_##VarName##__$$ {};\
	template <typename TArgumentType>\
	void AttributeSetter<FText, $$__##Type##_##VarName##__$$, TArgumentType>(TArgumentType& Arguments, v8::Local<v8::Context> Context, v8::Local<v8::Value> JsValue) {\
			Arguments._Text = WidgetAttribute::MakeAttribute<FText>(Context, JsValue);\
		}

	struct $$__FText_Text__$$ {};
	template <typename TArgumentType>
	void AttributeSetter<FText, $$__FText_Text__$$, TArgumentType>(TArgumentType& Arguments, v8::Local<v8::Context> Context, v8::Local<v8::Value> JsValue) {
		Arguments._Text = WidgetAttribute::MakeAttribute<FText>(Context, JsValue);
	};

