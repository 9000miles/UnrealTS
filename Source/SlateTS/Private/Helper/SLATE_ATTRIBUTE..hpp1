	MAKE_ATTRIBUTE_SETTER(FMargin, AreaTitlePadding);
	MAKE_ATTRIBUTE_SETTER(FMargin, HeaderPadding);
	MAKE_ATTRIBUTE_SETTER(FSlateFontInfo, AreaTitleFont);
