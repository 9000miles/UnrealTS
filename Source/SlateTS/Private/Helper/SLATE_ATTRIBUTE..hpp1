	MAKE_ATTRIBUTE_SETTER(FOptionalSize, HeightOverride);
	MAKE_ATTRIBUTE_SETTER(FOptionalSize, MinDesiredHeight);
	MAKE_ATTRIBUTE_SETTER(FOptionalSize, MinDesiredWidth);
	MAKE_ATTRIBUTE_SETTER(FOptionalSize, MaxDesiredWidth);
	MAKE_ATTRIBUTE_SETTER(FOptionalSize, MaxDesiredHeight);
	MAKE_ATTRIBUTE_SETTER(FOptionalSize, MinAspectRatio);
	MAKE_ATTRIBUTE_SETTER(FOptionalSize, MaxAspectRatio);
	MAKE_ATTRIBUTE_SETTER(FSlateColor, BodyBorderBackgroundColor);
